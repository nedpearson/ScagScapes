# Placeholders for the production build — the demo uses none of these.
# These names must match exactly what integrations() in supabase/functions/ss-api/core.ts reads.
# Set them as Supabase secrets, never in a file:
#   powershell -ExecutionPolicy Bypass -File .\supabase\setup-twilio-stripe.ps1

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=            # E.164, e.g. +12255551234. NOT "TWILIO_FROM_NUMBER" — the code reads TWILIO_FROM,
                        # and the wrong name fails silently: every message keeps logging as "simulated".
NWS_STATION=KBTR        # not read by the edge function (weather is fetched by station in code)
STRIPE_SECRET_KEY=
RESEND_API_KEY=
BRAVE_API_KEY=
SS_ADMIN_KEY=
VOICE_WEBHOOK_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
GOOGLE_REVIEW_LINK=      # not read by the edge function (set on the tenant, not as a secret)

# AI providers - any subset. pick() ignores a provider with no key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Ad spend sync (GET /ads/platforms lists what is missing by name)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
